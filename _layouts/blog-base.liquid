<!doctype html>
{% comment %}
  Page shell for the blog (list page, posts, tags).
  Styled after PaperMod / https://lilianweng.github.io/. The about and projects
  pages keep the al-folio layouts.
{% endcomment %}
{% assign full_name = site.first_name | append: ' ' | append: site.last_name %}
<html lang="{{ site.lang | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>{% if page.title and page.permalink != '/blog/' %}{{ page.title }} | {% endif %}{{ full_name }}{% if page.permalink == '/blog/' %} | blog{% endif %}</title>
    <meta name="author" content="{{ full_name }}">
    <meta name="description" content="{{ page.description | default: site.blog_description | strip_html | strip_newlines | escape }}">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <link rel="alternate" type="application/atom+xml" title="{{ full_name }}" href="{{ '/feed.xml' | relative_url }}">
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>{{ site.icon }}</text></svg>"
    >

    <script>
      // Apply the saved theme before the page paints. Shares the "theme" key with al-folio,
      // so the choice carries over between the blog and the rest of the site.
      (function () {
        var setting = null;
        try {
          setting = localStorage.getItem("theme");
        } catch (e) {}
        var dark = setting === "dark" || ((!setting || setting === "system") && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.setAttribute("data-theme", dark ? "dark" : "light");
      })();
    </script>

    <link rel="stylesheet" href="{{ '/assets/blog/header.css' | relative_url }}">
    <link rel="stylesheet" href="{{ '/assets/blog/blog.css' | relative_url }}">

    {% if page.math != false %}
      <script>
        window.MathJax = {
          tex: {
            tags: "ams",
            inlineMath: [
              ["$", "$"],
              ["\\(", "\\)"],
            ],
            displayMath: [
              ["$$", "$$"],
              ["\\[", "\\]"],
            ],
            processEscapes: true,
          },
          options: {
            skipHtmlTags: ["script", "noscript", "style", "textarea", "pre", "code"],
          },
        };
      </script>
      <script defer src="https://cdn.jsdelivr.net/npm/mathjax@3.2.2/es5/tex-mml-chtml.js"></script>
    {% endif %}
  </head>

  <body>
    {% include site-header.liquid %}

    <main class="main">
      {{ content }}
    </main>

    <footer class="footer">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ full_name }}</span>
      &middot;
      <span>Powered by <a href="https://jekyllrb.com/" rel="noopener noreferrer" target="_blank">Jekyll</a></span>
      &middot;
      <a href="{{ '/feed.xml' | relative_url }}">RSS</a>
    </footer>

    <script>
      // Theme toggle (light <-> dark).
      (function () {
        function toggle() {
          var next = document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", next);
          try {
            localStorage.setItem("theme", next);
          } catch (e) {}
        }
        document.getElementById("light-toggle").addEventListener("click", toggle);
        document.addEventListener("keydown", function (e) {
          if (e.altKey && (e.key === "t" || e.key === "T" || e.code === "KeyT")) toggle();
        });
      })();
    </script>
  </body>
</html>

---
layout: blog-base
---
{% comment %}
  A single blog post. Front matter used:
    title, date, description, tags   (standard)
    toc: false                        hide the "Table of Contents" box
    math: false                       don't load MathJax
{% endcomment %}
{% assign full_name = site.first_name | append: ' ' | append: site.last_name %}
{% assign words = content | strip_html | number_of_words %}
{% assign read_time = words | divided_by: 200 | at_least: 1 %}

<article class="post-single">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <div class="post-meta">
      Date: {{ page.date | date: '%B %-d, %Y' }} &nbsp;|&nbsp; Estimated Reading Time: {{ read_time }} min &nbsp;|&nbsp; Author:
      {{ page.author | default: full_name }}
    </div>
  </header>

  {% if page.toc != false %}
    <div class="toc" id="toc" hidden>
      <details>
        <summary accesskey="c" title="(Alt + C)">
          <span class="details">Table of Contents</span>
        </summary>
        <div class="inner"></div>
      </details>
    </div>
  {% endif %}

  <div class="post-content">
    {{ content }}

  </div>

  <footer class="post-footer">
    {% if page.tags.size > 0 %}
      <ul class="post-tags">
        {% for tag in page.tags %}
          <li>
            <a href="{{ '/blog/tags/' | relative_url }}#{{ tag | slugify }}">{{ tag }}</a>
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if page.next or page.previous %}
      <nav class="paginav">
        {% if page.next %}
          <a class="prev" href="{{ page.next.url | relative_url }}">
            <span class="title">« Prev</span>
            <span>{{ page.next.title }}</span>
          </a>
        {% endif %}
        {% if page.previous %}
          <a class="next" href="{{ page.previous.url | relative_url }}">
            <span class="title">Next »</span>
            <span>{{ page.previous.title }}</span>
          </a>
        {% endif %}
      </nav>
    {% endif %}
  </footer>
</article>

<script>
  // Runs before MathJax (which is deferred), so math copied into the TOC is typeset too.
  (function () {
    var content = document.querySelector(".post-content");
    var headings = content.querySelectorAll("h2[id], h3[id]");

    // Table of contents: nested list of h2 / h3.
    var toc = document.getElementById("toc");
    if (toc && headings.length > 1) {
      var root = document.createElement("ul");
      var currentSub = null;
      headings.forEach(function (h) {
        var li = document.createElement("li");
        var a = document.createElement("a");
        a.href = "#" + h.id;
        a.innerHTML = h.innerHTML;
        li.appendChild(a);
        if (h.tagName === "H2" || !root.lastElementChild) {
          root.appendChild(li);
          currentSub = null;
        } else {
          if (!currentSub) {
            currentSub = document.createElement("ul");
            root.lastElementChild.appendChild(currentSub);
          }
          currentSub.appendChild(li);
        }
      });
      toc.querySelector(".inner").appendChild(root);
      toc.hidden = false;
    }

    // "#" anchor shown when hovering a heading.
    content.querySelectorAll("h2[id], h3[id], h4[id], h5[id]").forEach(function (h) {
      var a = document.createElement("a");
      a.className = "anchor";
      a.href = "#" + h.id;
      a.setAttribute("aria-hidden", "true");
      a.textContent = "#";
      h.appendChild(a);
    });

    // "copy" button on code blocks.
    content.querySelectorAll("pre").forEach(function (pre) {
      var box = pre.closest(".highlight") || pre;
      if (box.querySelector(".copy-code")) return;
      var btn = document.createElement("button");
      btn.className = "copy-code";
      btn.type = "button";
      btn.textContent = "copy";
      btn.addEventListener("click", function () {
        var code = pre.querySelector("code") || pre;
        navigator.clipboard.writeText(code.innerText).then(function () {
          btn.textContent = "copied!";
          setTimeout(function () {
            btn.textContent = "copy";
          }, 2000);
        });
      });
      box.appendChild(btn);
    });
  })();
</script>

{% comment %}
  The site header, shared by every page (blog layouts and al-folio pages):
  name + light/dark toggle on the left, navigation on the right.
  Styles: assets/blog/header.css. The toggle keeps the id "light-toggle" because
  al-folio's theme.js wires its click handler to that id on al-folio pages.
{% endcomment %}
<header class="site-header">
  <nav class="site-nav">
    <div class="site-logo">
      <a href="{{ '/' | relative_url }}">{{ site.first_name }} {{ site.last_name }}</a>
      <button id="light-toggle" class="site-theme-toggle" type="button" title="Toggle light / dark (Alt + T)" aria-label="Toggle light / dark">
        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
      </button>
    </div>
    <ul class="site-menu">
      {% for p in site.pages %}
        {% if p.permalink == '/' %}{% assign about_title = p.title %}{% endif %}
      {% endfor %}
      {% assign here = page.url | split: '/' | where_exp: 'part', 'part != ""' | first %}
      <li>
        <a href="{{ '/' | relative_url }}" {% if page.permalink == '/' %}class="active"{% endif %}>{{ about_title }}</a>
      </li>
      {% assign sorted_pages = site.pages | sort: 'nav_order' %}
      {% for p in sorted_pages %}
        {% if p.nav and p.autogen == null %}
          {% if p.permalink contains '://' %}
            <li>
              <a href="{{ p.permalink }}">{{ p.title }}</a>
            </li>
          {% else %}
            {% assign section = p.permalink | split: '/' | where_exp: 'part', 'part != ""' | first %}
            <li>
              <a href="{{ p.url | relative_url }}" {% if section == here %}class="active"{% endif %}>{{ p.title }}</a>
            </li>
          {% endif %}
        {% endif %}
      {% endfor %}
    </ul>
  </nav>
</header>
